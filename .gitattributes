# Auto detect text files and perform LF normalization
* text=auto

# vRAAS2 profile payloads and manifest: byte-exact, never CRLF-normalize.
# The client SHA-256-verifies each .raas2 against the manifest hash; LF/CRLF
# rewriting desyncs the served bytes from the hash and blocks auto-download.
aircraft2/*.raas2 -text
aircraft2/current_version.json -text

# Generated supported-aircraft pages: the CI freshness check byte-compares them against a fresh
# render, so the checkout must always give the LF the generator writes.
supported-aircraft.md text eol=lf
supported-aircraft/index.html text eol=lf
